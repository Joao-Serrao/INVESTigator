{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions: local file + SQLite access scoped to the app-data dir, native HTTP (no CORS), and opening external links in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "fs:default",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$APPDATA/Investraton/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$APPDATA/Investraton/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPDATA/Investraton/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPDATA/Investraton/**" }] },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}
