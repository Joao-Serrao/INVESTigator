{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INVESTigator",
  "version": "1.0.0",
  "identifier": "com.investraton.investigator",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "npm run bundle",
    "beforeBuildCommand": "npm run bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "INVESTigator",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../../config/etf_sources.yaml": "config/etf_sources.yaml",
      "../../config/portfolio_plan.example.yaml": "config/portfolio_plan.example.yaml"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
