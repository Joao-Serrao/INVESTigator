# Copy to .env and fill in only what you use. Nothing here is required for the
# default CSV -> console path.

# ---- LLM brain (swappable) ----
# Provider: ollama | claude | template
#   ollama   -> local model, free, private (needs Ollama running)
#   claude   -> best quality, needs ANTHROPIC_API_KEY, ~cents/month
#   template -> no LLM at all, deterministic text (always works offline)
INVESTRATON_LLM=ollama

# Ollama (when INVESTRATON_LLM=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Claude (when INVESTRATON_LLM=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Delivery ----
# Targets: console | discord | email  (comma-separated, e.g. "console,discord")
INVESTRATON_DELIVERY=console

# Discord (incoming webhook URL)
DISCORD_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ---- Holdings ----
# No broker APIs (XTB discontinued theirs; Degiro never had one). You enter
# holdings by hand in data/holdings.csv (the app will replace this with a form).
# Investraton enriches them with public price + news data. The "amount_invested_eur"
# column is OPTIONAL — without it, positions are equal-weighted.
