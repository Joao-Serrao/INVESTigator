{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INVESTigator",
  "version": "0.1.0",
  "identifier": "com.investraton.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8765"
  },
  "app": {
    "windows": [
      {
        "title": "INVESTigator",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/investraton-app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
